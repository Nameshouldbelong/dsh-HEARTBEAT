{
  "name": "dsh-heartbeat",
  "version": "0.1.0",
  "description": "Session-level LLM prefix-cache keep-alive for DSH: HEARTBEAT tab + TG duty slash commands (/HTON /HTOFF /HTO)",
  "type": "module",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}