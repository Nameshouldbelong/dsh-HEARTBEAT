{
  "name": "dsh-heartbeat",
  "version": "0.3.0",
  "description": "Session-level LLM prefix-cache keep-alive + kimi-bound tool gate for DSH: HEARTBEAT/TOOL GATE tabs, TG duty commands (/HTON /HTOFF /HTO /TGON /TGOFF /TG)",
  "type": "module",
  "main": "lib/index.mjs",
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "heartbeat": {
    "protocolVersion": "hb2",
    "sidecarProtocol": "hb2"
  }
}
